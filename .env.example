APP_NAME=Pomodoro Studio
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/pomodoro.db
OUTPUT_DIR=./output
ASSETS_DIR=./assets
LOG_LEVEL=INFO

# Mode automàtic
AUTO_DEFAULT_PRIVACY=public
AUTO_MUSIC_DEFAULT=false

# Apagada en acabar
SHUTDOWN_DELAY_SECONDS=120
SHUTDOWN_COMMAND=systemctl poweroff

# Dies que es conserva un vídeo publicat abans d'esborrar-lo (si es demana)
KEEP_PUBLISHED_DAYS=3
