APP_NAME=Pomodoro Studio
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/pomodoro.db
OUTPUT_DIR=./output
ASSETS_DIR=./assets
LOG_LEVEL=INFO

# Generació d'imatges local opcional (AUTOMATIC1111 / Forge amb API activada)
# En execució local habitual: http://127.0.0.1:7860
# Des de Docker, usa una adreça accessible des del contenidor, p. ex. http://host.docker.internal:7860
IMAGE_A1111_URL=
IMAGE_A1111_MODEL=
IMAGE_GENERATION_DIR=./data/generated-images

# Mode automàtic
AUTO_DEFAULT_PRIVACY=public
AUTO_MUSIC_DEFAULT=false
AUTO_HIRES_SCALE=1.5
IMAGE_A1111_UPSCALER=R-ESRGAN 4x+
# auto, flux-schnell, flux-dev o sdxl
IMAGE_MODEL_PROFILE=auto
